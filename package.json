{
  "name": "@mithril/design-system",
  "version": "0.2.1",
  "description": "Shared Mithril design tokens and React chat components for Web and Desktop.",
  "license": "MIT",
  "files": [
    "resources",
    "src/react",
    "dist/react",
    "TYPOGRAPHY.md"
  ],
  "exports": {
    "./public-navigation.css": "./resources/public-navigation.css",
    "./mithril-mark.svg": {
      "types": "./resources/mithril-mark.d.ts",
      "default": "./resources/mithril-mark.svg"
    },
    "./desktop.css": "./resources/design-system.css",
    "./web-console.css": "./resources/web-console.css",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./chat.css": "./resources/chat-surface.css",
    "./font-faces.css": "./resources/font-faces.css",
    "./fonts/*": "./resources/fonts/*",
    "./visitor-locale": {
      "types": "./resources/visitor-locale.d.ts",
      "default": "./resources/visitor-locale.js"
    }
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "scripts": {
    "test:react": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:react": "tsc -p tsconfig.build.json",
    "test:locale": "node --test test/visitor-locale.check.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@testing-library/react": "^16.3.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "jsdom": "^26.1.0"
  },
  "type": "module"
}
